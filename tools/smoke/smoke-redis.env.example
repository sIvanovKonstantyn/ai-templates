# Redis connection for event smoke checks (smoke-events.py in the agent tools folder).
# Copy to ~/.config/spec-kit/smoke-redis.env (or set SPEC_SMOKE_REDIS_ENV_FILE) and run: chmod 600 <file>
# Never commit the real file. Use the event Redis the smoke-started service publishes to,
# as the service's dev configuration names it. Record that property in the runbook Smoke section.

# Host of the event Redis. For a cluster, use the configuration endpoint; MOVED/ASK redirects are followed.
SMOKE_REDIS_HOST=
SMOKE_REDIS_PORT=6379
# In-transit encryption. The system CA store verifies the certificate.
SMOKE_REDIS_TLS=true
SMOKE_REDIS_CLUSTER=true
# Leave USERNAME empty for password-only AUTH (auth token).
SMOKE_REDIS_USERNAME=
SMOKE_REDIS_PASSWORD=
SMOKE_REDIS_TIMEOUT_SECONDS=5

# Default stream for mark/expect. Name the stream the service publishes the changed event to.
SMOKE_EVENT_STREAM=
