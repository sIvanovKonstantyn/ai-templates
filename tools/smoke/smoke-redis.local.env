# Connection for the local Redis in docker-compose.redis.yml. Not a secret: the container is local only.
# Use it with: SPEC_SMOKE_REDIS_ENV_FILE=<tools>/smoke/smoke-redis.local.env (the self-test sets it).
SMOKE_REDIS_HOST=127.0.0.1
SMOKE_REDIS_PORT=16379
SMOKE_REDIS_TLS=false
SMOKE_REDIS_CLUSTER=false
SMOKE_REDIS_USERNAME=
SMOKE_REDIS_PASSWORD=local-smoke-password
SMOKE_REDIS_TIMEOUT_SECONDS=5
SMOKE_EVENT_STREAM=spec-smoke-selftest
